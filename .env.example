UNIOPS_DATABASE_URL=sqlite:///./uniops.db
UNIOPS_CORS_ORIGINS=["http://localhost:5173"]
UNIOPS_LOG_LEVEL=INFO

# EasyBooks live reads are opt-in. Never commit real values.
UNIOPS_EASYBOOKS_LIVE_ENABLED=false
UNIOPS_EASYBOOKS_BASE_URL=https://app133.easybooks.vn
UNIOPS_EASYBOOKS_COMPANY_ID=
UNIOPS_EASYBOOKS_BEARER_TOKEN=
UNIOPS_EASYBOOKS_COOKIE=
UNIOPS_EASYBOOKS_SALES_DETAIL_PATH=

# Sales list pagination. Leave the page size unset for one unpaginated request.
# The parameter names must be the ones actually observed; UniOps never guesses.
UNIOPS_EASYBOOKS_SALES_PAGE_SIZE=
UNIOPS_EASYBOOKS_SALES_PAGE_PARAM=
UNIOPS_EASYBOOKS_SALES_PAGE_SIZE_PARAM=
UNIOPS_EASYBOOKS_SALES_PAGE_MODE=offset
UNIOPS_EASYBOOKS_SALES_FIRST_PAGE=1
UNIOPS_EASYBOOKS_SALES_MAX_PAGES=200

