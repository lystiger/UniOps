UNIOPS_DATABASE_URL=sqlite:///./uniops.db
UNIOPS_CORS_ORIGINS=["http://localhost:5173"]
UNIOPS_LOG_LEVEL=INFO

# EasyBooks live reads are opt-in. Never commit real values.
UNIOPS_EASYBOOKS_LIVE_ENABLED=false
UNIOPS_EASYBOOKS_BASE_URL=https://app133.easybooks.vn
UNIOPS_EASYBOOKS_COMPANY_ID=
# Required for live reads. Scopes every request to your EasyBooks data group
# (seen as the `group` request header on any EasyBooks API call in your
# browser's developer tools). Without
# it the API returns an empty array instead of an error.
UNIOPS_EASYBOOKS_GROUP=
UNIOPS_EASYBOOKS_BEARER_TOKEN=
UNIOPS_EASYBOOKS_COOKIE=

# Preferred for unattended syncing. With these set UniOps obtains its own
# bearer token and renews it when one is rejected, so nobody has to paste a
# fresh token every 30 days. Use a dedicated EasyBooks user, not a personal
# login. Keep these in a secret store in any real deployment.
UNIOPS_EASYBOOKS_USERNAME=
UNIOPS_EASYBOOKS_PASSWORD=

# The sales list, count, and detail paths are observed constants in the
# connector. There is nothing to configure for them, and the sales list is not
# server-paginated: EasyBooks returns the whole matching array in one response.
